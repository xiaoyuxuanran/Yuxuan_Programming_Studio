  Result := CheckBaseFile('AppInventor.exe', '5f4b68a95b9ff8ba331acba3da82fe833356c70841581726a12769d907ccfe58', '4dc4112f69cb16122d43e3633ed77550519351484df75722406d64a5e509af10', '');
